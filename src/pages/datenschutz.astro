</Layout>
<style is:global>
    .dpsMain {
        background-color: var(--color-dark);
        color: var(--color-light);
    }

    .dps_page {
        max-width: 860px;
        margin: auto;
        padding: var(--padding-mobile);
        padding-top: calc(8svh + 2rem);

        color: rgb(255, 255, 255);

        h1 {
            font-size: 2.75rem;
            margin-bottom: 2rem;
        }

        h2 {
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 0.5rem;
            margin-top: 2.5rem;
            margin-bottom: 1rem;
            font-size: 2.25rem;
            font-weight: 450;
        }

