---
import KnopHeader from "../components/KnopHeader.astro";
import KnopWelcome from "../components/KnopWelcome.astro";
import Layout from "../layouts/Layout.astro";

import Link_arrow from "../assets/svgs/link_arrow.svg";

import { getCollection } from "astro:content";
const jobs = await getCollection("jobs");

jobs.sort((a, b) => a.data.order - b.data.order);
---

<Layout
    title="Karriere bei Knop Neustadt"
    description="Komm ins Team von Knop Neustadt! Ob im Handwerk, Verkauf, oder in der Verwaltung, wir suchen dich!"
>
    <KnopHeader />

    <KnopWelcome
        subHeading="Karriere"
        headingMain1="Deine Zukunft."
        headingSpan="Dein Handwerk."
        paragraph="Du willst etwas bewegen, statt nur zuschauen? Starte deine Ausbildung bei der Knop-Gruppe und werde Teil eines starken Teams!"
        bgDesktop="/images/karriereWelcomeDesktop.webp"
        bgMobile="/images/karriereWelcome.webp"
    />

    <section class="positionsSection" id="positions">
        <h2>Offene Stellen</h2>
        <ul>
            {
                jobs.map((job) => (
                    <li>
                        <a href={`/karriere/${job.id}`}>
                            <h3>{job.data.title}</h3>
                            <p>{job.data.description}</p>
                        </a>
                    </li>
                ))
            }
        </ul>
    </section>
</Layout>

<style>
    h3 {
    margin-bottom: .75rem;
    }

    ul {
        li {
            margin: 1rem 0rem;
            display: flex;
            align-items: center;
            position: relative;
            a {
                display: block;
                width: 100%;
                transition: all 0.1s ease-in-out;
                transition-delay: 0.1s;
                padding: 1rem;
                overflow: hidden;
                z-index: 1;
                position: relative;
                outline: var(--color-knop-magenta) 2px solid;
            }

            a::before {
                content: "";
                position: absolute;
                width: 100%;
                height: 100%;
                top: 0;
                left: 0;
                background-color: var(--color-knop-magenta);
                z-index: -1;
                transform: scaleY(0);
                transform-origin: top;
                transition: transform 0.5s;
            }

            a:hover::before {
                transform: scaleY(1);
            }

            a:hover {
                color: var(--color-light);

                .linkArrow {
                    path {
                        fill: var(--color-light);
                    }
                }
            }

            .linkArrow {
                position: absolute;
                top: 50%;
                transform: translateY(-52%);
                right: 0;
                margin-right: 1rem;
                z-index: 1;
                path {
                    fill: var(--color-dark);
                }
            }
        }
    }
</style>
