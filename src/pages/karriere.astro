---
import KnopHeader from "../components/KnopHeader.astro";
import KnopWelcome from "../components/KnopWelcome.astro";
import Layout from "../layouts/Layout.astro";

import Karriere_arrow from "../assets/svgs/karriere_arrow.svg";

import { getCollection } from "astro:content";
import KnopFooter from "../components/KnopFooter.astro";
const jobs = await getCollection("jobs");

jobs.sort((a, b) => a.data.order - b.data.order);
---

<Layout
    title="Karriere bei Knop Neustadt"
    description="Komm ins Team von Knop Neustadt! Ob im Handwerk, Verkauf, oder in der Verwaltung, wir suchen dich!"
>
    <KnopHeader />

    <KnopWelcome
        subHeading="Karriere"
        headingMain1="Deine Zukunft."
        headingSpan="Dein Handwerk."
        paragraph="Du willst etwas bewegen, statt nur zuschauen? Starte deine Ausbildung bei der Knop-Gruppe und werde Teil eines starken Teams!"
        bgDesktop="/images/karriereWelcomeDesktop.webp"
        bgMobile="/images/karriereWelcome.webp"
    />

    <section class="positionsSection" id="positions">
        <h2>Jobangebote</h2>
        <ul>
            {
                jobs.map((job) => (
                    <li>
                        <a href={`/karriere/${job.id}`}>
                            <div>
                                <h3>{job.data.title}</h3>
                                <div class="jobInfos">
                                    <p>{job.data.location}</p>
                                    <p>{job.data.employment}</p>
                                    <p>{job.data.startDate}</p>
                                </div>
                            </div>
                            <Karriere_arrow />
                        </a>
                    </li>
                ))
            }
        </ul>
    </section>

    <KnopFooter />
</Layout>

<style>
    h2 {
        margin: auto;
        margin-bottom: 3rem;
        margin-top: 3rem;
        max-width: var(--max-width);
    }

    h3 {
        margin-bottom: 1rem;

        font-weight: 600;
    }

    ul {
        max-width: var(--max-width);
        margin: auto;
        li {
            margin-bottom: 2rem;
            a {
                width: 100%;
                transition: all 0.2s ease-in-out;
                padding: var(--padding-mobile);
                z-index: 1;
                border: var(--color-knop-magenta) 1px solid;
                display: flex;
                flex-direction: column;
                gap: 1.5rem;

                svg {
                    path {
                        transition: all 0.2s ease 0.06s;

                        fill: var(--color-dark);
                    }
                }
            }

            a:hover {
                color: var(--color-light);
                padding-left: 2rem;
                padding-right: 2rem;
                background-color: var(--color-knop-magenta);

                svg {
                    path {
                        fill: var(--color-light);
                    }
                }

                .jobInfos {
                    p {
                        color: var(--color-light);
                        border-color: var(--color-light);
                    }
                }
            }
        }
    }

    .jobInfos {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;

        p {
            font-size: clamp(0.75rem, 2vw, 1rem);
            padding: 0.5rem;
            color: var(--color-knop-magenta);
            border: 1px solid var(--color-knop-magenta);
            line-height: 100%;
            font-weight:;
        }
    }

    @media screen and (min-width: 800px) {
        
        h2{
            margin-top: 0;
        }

        h3 {
            margin-bottom: 1.5rem;
        }
        ul {
            li {
                a {
                    flex-direction: row;
                    align-items: center;
                    justify-content: space-between;
                }
            }
        }

        .jobInfos {
            p {
                padding: 1rem;
            }
        }
    }
</style>
