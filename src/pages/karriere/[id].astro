---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import KnopHeader from "../../components/KnopHeader.astro";
import KnopFooter from "../../components/KnopFooter.astro";
import KnopNavLinkBack from "../../components/KnopNavLinkBack.astro";
import KnopLink from "../../components/KnopLink.astro";

export async function getStaticPaths() {
  const jobs = await getCollection("jobs");
  return jobs.map((job) => ({
    params: { id: job.id },
    props: { job },
  }));
}
// 2. For your template, you can get the entry directly from the prop
const { job } = Astro.props;
const { Content } = await render(job);
---

<Layout title={job.data.title} mainClass="jobMain">
  <KnopHeader />

  <div class="jobWelcome">
    <div class="welcomeWrapper">
      <h1>{job.data.title}</h1>
      <div class="jobDetails">
        <p>Art: {job.data.employment}</p>
        <p>Standort: {job.data.location}</p>
        <p>Ab: {job.data.startDate}</p>
      </div>
    </div>
  </div>

  <div class="contentWrapper">
    <div class="content">
      <Content />
    </div>
    <div class="contentContact">
      <h3>Interesse Geweckt?</h3>
      <p>
        Passt diese Position zu Ihren Vorstellungen? Dann freuen wir uns darauf,
        Sie kennenzulernen! Senden Sie Ihre Unterlagen ganz unkompliziert per
        E-Mail an Tatjana Knop oder melden Sie sich bei Fragen direkt vorab bei
        uns.
      </p>
      <KnopLink
        linkto="mailto:tatjana.knop@knop-neustadt.de"
        linkName="Kontakt aufnehmen"
      />
      <KnopLink linkto="/karriere" linkName="Stellenangebote"  />
    </div>
  </div>

  <KnopFooter />
</Layout>

<style>
  .jobWelcome {
    background-color: var(--color-dark);
    color: var(--color-light);
    padding: var(--padding-mobile);
    padding-top: 15svh;
    padding-bottom: 1.25rem;
  }

  .jobDetails {
    margin-top: 1.5rem;
    font-weight: 400;

    p {
      font-size: 1rem;
    }
  }

  .welcomeWrapper,
  .content {
    max-width: 1440px;
    margin: auto;
  }

  .welcomeWrapper {
    a {
      font-weight: 400;
      transition: all ease 0.2s;
      font-size: 1.25rem;
    }

    .linkWrapper {
      margin-bottom: 3rem;
    }
  }

  .content {
    padding: var(--padding-mobile);
    background-color: var(--color-light);

    p {
      padding-bottom: 0.75rem;
    }

    h1 {
      margin-bottom: 2rem;
      font-weight: 500;
      font-size: 3rem;
    }

    h2{
      font-weight: 500;
    }

    h2:first-of-type{
      margin-top: 0;
    }

    ul {
      list-style: square;
      margin-bottom: 1.5rem;
      li {
        margin-left: 2rem;
        padding-left: 0.5rem;
      }

      li::marker {
        color: var(--color-knop-magenta);
      }
    }
  }

  .contentContact {
    padding: 2rem var(--padding-mobile);
    background-color: var(--color-dark);
    color: var(--color-light);

    .linkBtn {
      border-color: var(--color-light);
      color: var(--color-light);
    }
  }

  @media screen and (min-width: 1024px) {
    .jobWelcome {
      padding: 0;
      padding-top: 2rem;
    }

    .jobDetails {
      margin-bottom: 0;
    }

    .welcomeWrapper {
      padding: 3rem;
      padding-top: 6rem;
    }

    .contentWrapper {
      display: flex;
      max-width: var(--max-width);
      margin: auto;
      position: relative;
    }

    .content {
      border-right: 1px solid var(--color-dark);
      padding: 3rem;
      max-width: 70%;
      h2 {
        font-size: 2.75rem;
        margin-bottom: 1rem;
      }

      p,
      ul {
        font-size: 1;
      }
    }

    .contentContact {
      max-width: 30%;
      position: sticky;
      top: 4rem;
      left: 0;
      padding: 3rem 3rem;
      height: fit-content;
      background-color: var(--color-light);
      color: var(--color-dark);
      .linkBtn {
        border-color: var(--color-dark);
        color: var(--color-dark);
      }

      p{
        font-size: 1rem;
      }
    }
  }
</style>
