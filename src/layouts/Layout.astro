---
import {Font} from "astro:assets";
import "../styles/global.css";
import { describe } from "astro:schema";

interface Props{
	title:string;
	description?:string;
	image?:string;
}

const {title = "Küchentrends Knop Neustadt", description = "Küchentrends der Firma Knop in Neustadt", image = "/images/welcomePicture.webp"} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="description" content={description}>
		<meta name="generator" content={Astro.generator} />
		<meta property="og:image" content={image}>
		<title>{title}</title>
		<Font cssVariable="--font-cousine" />
		<Font cssVariable="--font-alumni" />
	</head>
	<body>
		<main>
			<slot />
		</main>
	</body>
</html>
