---
import { Image } from "astro:assets";
import logoWhite from "../assets/images/KK_Logo_weiß.png";
---

<div id="nav-overlay" class="nav-overlay"></div>

<nav id="main-nav">
    <div class="nav-top-bar">
        <a href="/" class="logo-link">
            <Image
                src={logoWhite}
                alt="Logo von Knop Küchentrends Neustadt"
                width={300}
                loading={"eager"}
            />
        </a>

        <button
            id="menu-toggle"
            class="btn btn-ghost btn-circle text-white lg:hidden swap swap-rotate"
            aria-label="Menü umschalten"
        >
            <input type="checkbox" id="menu-checkbox" class="hidden" />

            <svg
                class="swap-off fill-current h-6 w-6"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M4 6h16M4 12h16M4 18h7"></path>
            </svg>

            <svg
                class="swap-on fill-current h-6 w-6"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M6 18L18 6M6 6l12 12"></path>
            </svg>
        </button>
    </div>

    <ul class="nav-links">
        <li><a href="/#partnersWrapper" class="nav-link">Hersteller</a></li>
        <li><a href="/#processWrapper" class="nav-link">Ablauf</a></li>
        <li><a href="/#contactWrapper" class="nav-link">Kontakt</a></li>
        <li>
            <a
                href="https://karriere.knop-neustadt.de"
                class="nav-link"
                target="_blank">Karriere</a>
        </li>
        <li class="dropdown lg:dropdown-end">
            <div
                tabindex="0"
                role="button"
                class="nav-link cursor-pointer flex items-center gap-1"
            >
                Weitere Gewerke
                <svg
                    class="h-4 w-4 fill-current opacity-60"
                    viewBox="0 0 20 20"
                >
                    <path
                        d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"
                    ></path>
                </svg>
            </div>
            <ul
                tabindex="0"
                class="dropdown-content z-[110] menu p-4 shadow-lg mt-4"
            >
                <li>
                    <a href="https://knop-energietechnik.de/" target="_blank"
                        >Energietechnik</a
                    >
                </li>
                <li>
                    <a href="https://www.knop-neustadt.de/" target="_blank"
                        >Ambientezentrum</a
                    >
                </li>
            </ul>
        </li>
    </ul>
</nav>

<style>
    /* HINTERGRUND-VERDUNKELUNG (OVERLAY) */
    .nav-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background-color: rgba(0, 0, 0, 0.6); /* Grad der Verdunkelung */
        z-index: 90; /* Liegt direkt unter der Navbar (z-index: 100) */
        opacity: 0;
        pointer-events: none; /* Blockiert Klicks im geschlossenen Zustand nicht */
        backdrop-filter: blur(
            2px
        ); /* Optional: Macht den Hintergrund zusätzlich leicht unscharf */
        transition: opacity 0.4s ease;
    }

    /* Wenn das Menü offen ist, wird das Overlay sichtbar */
    .nav-overlay.open {
        opacity: 1;
        pointer-events: auto; /* Verhindert Klicks auf die Seite, wenn offen */
    }

    .logo-link img {
        width: 35px;
        height: 35px;
        object-fit: contain;
    }

    #menu-toggle svg {
        width: 20px !important; /* Vorher 24px */
        height: 20px !important; /* Vorher 24px */
    }

    /* NAVBAR STYLES */
    nav {
        position: fixed;
        left: 50%;
        top: var(--padding-mobile);
        width: calc(100vw - (var(--padding-mobile) * 2));
        transform: translate(-50%);
        padding: 1rem 1rem;
        z-index: 100; /* Liegt über dem Overlay */

        background-color: #19181fb6;
        background-blend-mode: overlay;
        backdrop-filter: blur(4px);
        box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.3);
        height: 8svh;
        display: flex;
        flex-direction: column;
        transition: height 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        overflow: hidden;
    }

    nav.open {
        height: fit-content;
        overflow: visible;
    }

    .nav-top-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        height: calc(6svh - 1rem);
    }

    .nav-links {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 1.5rem;
        flex-grow: 1;
        padding: 2rem 0;
        opacity: 0;
        transform: translateY(-10px);
        transition:
            opacity 0.3s ease,
            transform 0.3s ease;
    }

    nav.open .nav-links {
        opacity: 1;
        transform: translateY(0);
        transition-delay: 0.1s;
    }

    .nav-links a,
    .dropdown {
        color: var(--color-light);
        text-decoration: none;
        font-size: 1.5rem;
        font-weight: bold;
    }

    .dropdown-content {
        background-color: var(--color-dark-transparent);
    }

    @media screen and (min-width: 1024px) {
        /* Overlay auf Desktop komplett deaktivieren */
        .nav-overlay,
        .nav-overlay.open {
            display: none;
        }

        nav {
            flex-direction: row;
            justify-content: space-between;
            align-items: center;
            padding: 1.5rem 2.5rem;
            width: calc(100vw - (var(--padding-tablet) * 2));
            top: 1.25rem;
            padding: 0 1rem;
            overflow: visible;
        }

        .logo-link img {
            width: 50px;
            height: 50px;
            object-fit: contain;
        }

        nav.open {
            height: 6svh;
            overflow: visible;
        }

        .nav-top-bar {
            width: auto;
            height: auto;
        }

        .nav-links {
            flex-direction: row;
            opacity: 1;
            transform: none;
            padding: 0;
            gap: 0;
            flex-grow: 0;
            li {
                padding-right: 1.25rem;

                &:last-child {
                    padding-right: 0;
                }
            }
        }

        .nav-links a {
            position: relative;
        }

        .nav-links a::after {
            content: "";
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 2px;
            background-color: var(--color-knop-magenta);
            transform: scaleX(0);
            transform-origin: right;
            transition: transform 0.3s ease-in-out;
        }

        .nav-links a:hover::after {
            transform: scaleX(1);
            transform-origin: left;
        }
    }
    @media screen and (min-width: 1450px) {
        nav {
            height: 5vh;
            width: calc(100vw - (var(--padding-desktop) * 2));
        }
    }
</style>

<script>
    const nav = document.getElementById("main-nav");
    const overlay = document.getElementById("nav-overlay");
    const toggleBtn = document.getElementById("menu-toggle");
    const menuCheckbox = document.getElementById(
        "menu-checkbox",
    ) as HTMLInputElement;
    const links = document.querySelectorAll(".nav-link");

    // Funktion zum Umschalten des Zustands (Zentralisiert)
    function toggleMenu() {
        const isOpen = nav?.classList.toggle("open");
        overlay?.classList.toggle("open", isOpen);

        // DaisyUI-Checkbox synchronisieren für die Icon-Rotation
        if (menuCheckbox) {
            menuCheckbox.checked = isOpen || false;
        }
    }

    // Funktion zum erzwungenen Schließen
    function closeMenu() {
        nav?.classList.remove("open");
        overlay?.classList.remove("open");
        if (menuCheckbox) menuCheckbox.checked = false;
    }

    // Event Listener
    toggleBtn?.addEventListener("click", toggleMenu);
    overlay?.addEventListener("click", closeMenu); // Schließt das Menü auch beim Klick ins Dunkle

    // Menü automatisch schließen bei Link-Klick
    links.forEach((link) => {
        link.addEventListener("click", closeMenu);
    });
</script>
