---
import { Image } from "astro:assets";
import haeckerImg from "../assets/images/Häcker.jpg";
import neffImg from "../assets/images/neff.jpg";
import boschImg from "../assets/images/bosch.webp";
import ballerinaImg from "../assets/images/ballerina.jpg";
import smegImg from "../assets/images/smeg.jpg";
import nobiliaImg from "../assets/images/nobilia.jpg";

// Zentrale Datenquelle für alle Partner
const partners = [
    {
        id: "haecker",
        name: "Häcker",
        imgSrc: haeckerImg,
        text: "Häcker ist einer der größten und renommiertesten deutschen Hersteller für Küchenmöbel. Mit seinen Produktlinien Systemat und Concept130 bietet die Firma eine große Auswahl an modernen, funktionalen Designs, die sich flexibel an jeden Lebensstil und jede Raumgröße anpassen lassen.",
        branch: "Möbel",
        since: "1999",
        origin: "Verl",
        segment: "Premium",
    },
    {
        id: "smeg",
        name: "Smeg",
        imgSrc: smegImg,
        text: "Italienisches Design trifft auf modernste Technik: Smeg ist weltbekannt für seine ikonischen Haushaltsgeräte im Retro-Look und professionelle Küchentechnik.",
        branch: "Elektro",
        since: "2004",
        origin: "Italien",
        segment: "Einstieg",
    },
    {
        id: "bosch",
        name: "Bosch",
        imgSrc: boschImg,
        text: "Bosch steht für verlässliche Qualität und innovative Technik. Die Einbaugeräte fügen sich nahtlos in moderne Küchenkonzepte ein und erleichtern den Alltag spürbar.",
        branch: "Möbel",
        since: "1999",
        origin: "Verl",
        segment: "Premium",
    },
    {
        id: "neff",
        name: "Neff",
        imgSrc: neffImg,
        text: "Neff baut Küchengeräte für Menschen, die mit Leidenschaft kochen. Einzigartige Features wie die vollversenkbare Slide&Hide® Backofentür zeichnen die Marke aus.",
        branch: "Möbel",
        since: "1999",
        origin: "Verl",
        segment: "Premium",
    },
    {
        id: "ballerina",
        name: "Ballerina",
        imgSrc: ballerinaImg,
        text: "Ballerina-Küchen stehen für Individualität und handwerkliche Perfektion. Sie bieten innovative Stauraumlösungen und wurden mehrfach für ihre Qualität ausgezeichnet.",
        branch: "Möbel",
        since: "1999",
        origin: "Verl",
        segment: "Premium",
    },
    {
        id: "nobilia",
        name: "Nobilia",
        imgSrc: nobiliaImg,
        text: "Nobilia ist der Marktführer im deutschen Küchenbau. Das Unternehmen bietet intelligent strukturierte Küchen mit einem hervorragenden Preis-Leistungs-Verhältnis.",
        branch: "Möbel",
        since: "1999",
        origin: "Verl",
        segment: "Premium",
    },
];
---

<section class="partnersWrapper">
    <div class="subHeading"><p>Unsere Partner</p></div>

    <div class="partnersContent">
        <div class="buttonsWrapper">
            {
                partners.map((partner, index) => (
                    <button
                        class={`partnerBtn ${index === 0 ? "active" : ""}`}
                        data-partner={partner.id}
                    >
                        {partner.name}
                    </button>
                ))
            }
        </div>

        <div class="imageContainer">
            {
                partners.map((partner, index) => (
                    <Image
                        src={partner.imgSrc}
                        alt={`Küche von ${partner.name}`}
                        class={`partnerImage ${index === 0 ? "active" : ""}`}
                        data-id={partner.id}
                        width={600}
                        widths={[600, 800, 1200]}
                        sizes="(max-width: 600px) 600px,(max-width:800px) 800px, (max-width: 1200px) 1200px"
                        loading="lazy"
                    />
                ))
            }
        </div>

        <div class="partnersDescriptionWrapper">
            <div class="descriptionsContainer">
                {
                    partners.map((partner, index) => (
                        <div
                            class={`partnersDescription ${index === 0 ? "active" : ""}`}
                            data-description={partner.id}
                        >
                            <div class="textBlock">
                                <h2>{partner.name}</h2>
                                <p>{partner.text}</p>
                            </div>
                        </div>
                    ))
                }
            </div>

            <div class="infoLeisteContainer">
                {
                    partners.map((partner, index) => (
                        <div
                            class={`partnersDescriptionInfo ${index === 0 ? "active" : ""}`}
                            data-info={partner.id}
                        >
                            <div class="infoPoint">
                                <p class="infoHeading">Branche</p>
                                <p class="infoText">{partner.branch}</p>
                            </div>
                            <div class="infoPoint">
                                <p class="infoHeading">Seit</p>
                                <p class="infoText">{partner.since}</p>
                            </div>
                            <div class="infoPoint">
                                <p class="infoHeading">Herkunft</p>
                                <p class="infoText">{partner.origin}</p>
                            </div>
                            <div class="infoPoint">
                                <p class="infoHeading">Segment</p>
                                <p class="infoText">{partner.segment}</p>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </div>
</section>

<style>
    .partnersWrapper {
        padding-top: var(--padding-desktop);
        min-height: 100svh;
        padding-bottom: var(--padding-desktop);
    }

    .partnersContent {
        min-height: 80svh;
        margin-top: 1rem;
    }

    .buttonsWrapper {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1px;
        background-color: #fffffc;
    }

    button {
        background-color: #fffffc;
        outline: 1px solid var(--border-color);
        opacity: 0.6;
        cursor: pointer;
        padding: 0.5rem 0rem;
        color: var(--color-dark);
        transition: opacity 0.2s;
        text-align: start;
        padding-left: 1rem;
    }

    button.active {
        opacity: 1;
        font-weight: bold;
        outline: 1px solid var(--color-knop-magenta);
    }

    .imageContainer {
        position: relative;
        overflow: hidden;
        display: grid;
        grid-template-rows: 100%;
    }

    .partnerImage {
        grid-row: 1;
        grid-column: 1;
        height: 100%;
        width: 100%;
        margin-top: 2rem;
        aspect-ratio: 1/1;
        opacity: 0;
        pointer-events: none;
    }

    .partnerImage.active {
        pointer-events: auto;
    }

    h2 {
        font-size: 5rem;
    }

    .descriptionsContainer {
        position: relative;
        height: 100%;
        min-height: 380px; /* Genug Platz für Text + Zusatzinfos, damit nichts springt */
        display: grid;
        grid-template-columns: 1fr;
    }

    .partnersDescription {
        grid-column: 1;
        grid-row: 1;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        height: 100%;
        width: 100%;
        opacity: 0;

        p{
            padding-bottom: 1rem ;
            font-size: 1rem;
        }
    }

    .partnersDescription.active {
        display: flex;
        opacity: 1;
    }

    .textBlock {
        margin: auto;
    }

    .infoLeisteContainer {
        display: grid;
        grid-template-rows: 1fr;
        border-top: 1px solid var(--border-color);
        border-bottom: 1px solid var(--border-color);
    }

    .partnersDescriptionInfo {
        opacity: 0;
        grid-column: 1;
        grid-row: 1;
        display: flex;
        justify-content: space-between;
        padding: 1rem 0rem;
        width: 100%;
        text-align: center;

        .infoPoint {
            display: flex;
            flex-direction: column;

            .infoHeading {
                font-size: 0.75rem;
                font-weight: 400;
            }

            .infoText {
                font-weight: bold;
            }

            p {
                font-size: 1rem;
            }
        }
    }

    .partnersDescriptionInfo.active {
        opacity: 1;
    }

    p {
        font-size: 1.25rem;
    }

    @media screen and (min-width: 1024px) {
        button {
            text-align: center;
            padding-left: 0;
        }

        .subHeading {
            display: grid;
            grid-template-columns: repeat(12, 1fr);

            p {
                grid-column: 9/13;
                border-bottom: 1px solid var(--border-color);
            }
        }

        .partnersWrapper {
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding-top: var(--padding-desktop);
        }

        .partnersContent {
            display: grid;
            grid-template-columns: repeat(12, 1fr);
            grid-template-rows: 1fr 4fr;
            min-height: 0;
            height: 60svh;
            margin-top: 0;
        }

        .buttonsWrapper {
            grid-column: 9/13;
            grid-template-columns: repeat(3, 1fr);
        }

        .imageContainer {
            grid-column: 1/7;
            grid-row: 1/3;
            width: 100%;
            height: 100%;

            .partnerImage {
                margin: 0;
            }
        }

        .partnerImage {
            margin: 0;
            object-position: center center;
        }

        .partnersDescriptionWrapper {
            grid-column: 9/13;
            display: flex;
            flex-direction: column;
            justify-content: end;
        }

        .partnersDescription {
            transform: translateY(-1rem);
            h2 {
                margin: 0;
            }
        }

        .partnerBtn {
            transition: all 0.2s ease-in-out;
        }

        .partnerBtn:hover {
            outline-color: var(--color-knop-magenta);
        }

        .partnersDescriptionInfo {
            text-align: start;


        }
    }
</style>

<script>
    import { gsap } from "gsap";

    const buttons = document.querySelectorAll(".partnerBtn");
    let currentPartnerId = document
        .querySelector(".partnerBtn.active")
        ?.getAttribute("data-partner");

    // Initialen Zustand für das ALLERERSTE Element setzen, damit es beim Laden sichtbar ist
    gsap.set(
        [
            ".partnerImage.active",
            ".partnersDescription.active",
            ".partnersDescriptionInfo.active",
        ],
        {
            opacity: 1,
            y: 0,
        },
    );

    buttons.forEach((button) => {
        button.addEventListener("click", () => {
            const targetPartner = button.getAttribute("data-partner");

            if (targetPartner === currentPartnerId) return;
            currentPartnerId = targetPartner;

            buttons.forEach((btn) => btn.classList.remove("active"));
            button.classList.add("active");

            const activeImg = document.querySelector(".partnerImage.active");
            const activeDesc = document.querySelector(
                ".partnersDescription.active",
            );
            const activeInfo = document.querySelector(
                ".partnersDescriptionInfo.active",
            );

            const nextImg = document.querySelector(
                `.partnerImage[data-id="${targetPartner}"]`,
            );
            const nextDesc = document.querySelector(
                `.partnersDescription[data-description="${targetPartner}"]`,
            );
            const nextInfo = document.querySelector(
                `.partnersDescriptionInfo[data-info="${targetPartner}"]`,
            );

            const tl = gsap.timeline();

            // 1. Altes Zeug ausfaden
            if (activeImg && activeDesc && activeInfo) {
                tl.to([activeImg, activeDesc, activeInfo], {
                    opacity: 0,
                    y: -15,
                    duration: 0.2,
                    ease: "power2.in",
                    onComplete: () => {
                        // Klassen erst entfernen, WENN die Animation vorbei ist
                        activeImg.classList.remove("active");
                        activeDesc.classList.remove("active");
                        activeInfo.classList.remove("active");
                    },
                });
            }

            // 2. Neues Zeug einfaden
            if (nextImg && nextDesc && nextInfo) {
                // WICHTIG: Wir zwingen GSAP DIREKT dazu, die Elemente unsichtbar auf Startposition zu setzen,
                // BEVOR wir die Klassen hinzufügen. Das verhindert das Aufblitzen komplett!
                gsap.set([nextImg, nextDesc, nextInfo], {
                    y: 15,
                    opacity: 0,
                });

                nextImg.classList.add("active");
                nextDesc.classList.add("active");
                nextInfo.classList.add("active");

                tl.to([nextImg, nextDesc, nextInfo], {
                    opacity: 1,
                    y: 0,
                    duration: 0.35,
                    ease: "power2.out",
                });

                // Micro-Animation für innere Texte
                const textElements = nextDesc.querySelectorAll("h2, p");
                const infoPoints = nextInfo.querySelectorAll(".infoPoint");

                tl.fromTo(
                    [textElements, infoPoints],
                    { opacity: 0, y: 8 },
                    {
                        opacity: 1,
                        y: 0,
                        duration: 0.25,
                        stagger: 0.04,
                        ease: "power1.out",
                    },
                    "-=0.2",
                );
            }
        });
    });
</script>
