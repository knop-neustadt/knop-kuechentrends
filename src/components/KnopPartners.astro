---
import type { Partner } from "../data/partnersInterface.ts";

interface Props {
    partners?: Partner[];
}

const { partners = [] } = Astro.props;
import { Image } from "astro:assets";
---

<section class="partnersWrapper" id="partnersWrapper">
    <div class="partnersContent">
        <div class="buttonsWrapper">
            {
                partners.map((partner, index) => (
                    <button
                        class={`partnerBtn ${index === 0 ? "active" : ""}`}
                        data-partner={partner.id}
                    >
                        {partner.name}
                    </button>
                ))
            }
        </div>

        <div class="partnersDescriptionWrapper">
            <div class="descriptionsContainer">
                {
                    partners.map((partner, index) => (
                        <div
                            class={`partnersDescription ${index === 0 ? "active" : ""}`}
                            data-description={partner.id}
                        >
                            <div class="textBlock">
                                <h2>{partner.name}</h2>
                                <div set:html={partner.text} />
                            </div>
                        </div>
                    ))
                }
            </div>

            <div class="infoLeisteContainer">
                {
                    partners.map((partner, index) => (
                        <div
                            class={`partnersDescriptionInfo ${index === 0 ? "active" : ""}`}
                            data-info={partner.id}
                        >
                            <div class="infoPoint">
                                <p class="infoHeading">Branche</p>
                                <p class="infoText">{partner.branch}</p>
                            </div>
                            <div class="infoPoint">
                                <p class="infoHeading">Seit</p>
                                <p class="infoText">{partner.since}</p>
                            </div>
                            <div class="infoPoint">
                                <p class="infoHeading">Standort</p>
                                <p class="infoText">{partner.origin}</p>
                            </div>
                            <div class="infoPoint">
                                <p class="infoHeading">Segment</p>
                                <p class="infoText">{partner.segment}</p>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>

        <div class="imageWrapper">
            <div class="imageContainer">
                {
                    partners.map((partner, index) => (
                        <Image
                            src={partner.imgSrc}
                            alt={`BEsipielbild des Herstellers ${partner.name}`}
                            class={`partnerImage ${index === 0 ? "active" : ""}`}
                            data-id={partner.id}
                            widths={[240, 540, 1400]}
                            sizes="(max-width: 360px) 240px,(max-width:720px) 540px, (max-width: 1600px) 1400px"
                            loading="lazy"
                        />
                    ))
                }
            </div>
        </div>
    </div>
</section>

<style>
    .partnersWrapper {
        padding: 4rem var(--padding-mobile);
        background-color: var(--color-light);
        color: var(--color-dark);
    }

    .partnersContent {
        border: 1px solid var(--border-color);
    }

    .buttonsWrapper {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        background-color: var(--color-light);
    }

    button {
        background-color: var(--color-light);
        opacity: 0.6;
        cursor: pointer;
        color: var(--color-dark);
        transition: opacity 0.2s;
        text-align: center;
        padding: 1rem;
        border-bottom: 1px solid var(--border-color);
        border-right: 1px solid var(--border-color);
    }

    button:nth-child(2n) {
        border-right: none;
    }

    button.active {
        opacity: 1;
        font-weight: bold;
        border-color: var(--color-knop-magenta);
        background-color: var(--color-knop-magenta);
        color: var(--color-light);
    }

    .imageContainer {
        display: grid;
        overflow: hidden;
        grid-template-columns: 1fr;
        grid-template-rows: 1fr;
        padding: var(--padding-mobile);
    }

    .partnerImage {
        grid-column: 1;
        grid-row: 1;
        opacity: 0;
        pointer-events: none;
        object-fit: cover;
        object-position: center;
    }

    .partnerImage.active {
        pointer-events: auto;
        display: block;
    }

    .descriptionsContainer {
        position: relative;
        height: 100%;
        min-height: 380px;
        display: grid;
        grid-template-columns: 1fr;
    }

    .partnersDescription {
        grid-column: 1;
        grid-row: 1;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        opacity: 0;
        display: none;
        padding: var(--padding-mobile);

        p {
            padding-bottom: 1.5rem;
            font-size: 1rem;
        }

        h2 {
            margin-top: 0;
        }
    }

    .partnersDescription.active {
        display: flex;
        opacity: 1;
        display: block;
    }

    .infoLeisteContainer {
        display: grid;
        grid-template-columns: 1fr;
        grid-template-rows: 1fr;

        .partnersDescriptionInfo {
            opacity: 0;
            justify-content: space-between;
            display: none;
            grid-column: 1;
            grid-row: 1;

            .infoPointWrapper {
            }

            .infoPoint {
                display: flex;
                flex-direction: column;
                flex: 50%;
                text-align: center;
                align-items: center;
                justify-content: center;
                padding: 1rem;

                border: 1px solid var(--border-color);

                .infoHeading {
                    font-size: 0.9rem;
                    font-weight: 300;
                    margin-bottom: 0.5rem;
                }

                .infoText {
                    font-weight: bold;
                }

                p {
                    font-size: clamp(0.5rem, 4vw, 1.15rem);
                }
            }

            .infoPoint:nth-child(2n) {
                border-left: none;
                border-right: none;
            }

            .infoPoint:nth-child(1n) {
                border-left: none;
            }
            .infoPoint:nth-child(n + 3) {
                border-top: none;
            }
        }
    }

    .partnersDescriptionInfo.active {
        opacity: 1;
        display: grid;
        grid-template-columns: 1fr 1fr;
    }

    .textBlock {
        padding: 2rem var(--padding-mobile);
    }

    @media screen and (min-width: 900px) {
        button {
            text-align: center;
            padding-left: 0;
        }

        button {
            background-color: var(--color-light);
            border: 1px solid var(--border-color);
            opacity: 0.6;
            cursor: pointer;
            color: var(--color-dark);
            transition: opacity 0.2s;
            text-align: center;
            padding: 1rem;
            border-top: none;
        }

        button:nth-child(2n) {
            border-left: none;
            border-right: none;
        }
        button:last-of-type {
            border-right: none;
        }

        .partnersWrapper {
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: var(--padding-tablet);
        }

        .partnersContent {
            display: grid;
            grid-template-columns: repeat(12, 1fr);
        }

        .buttonsWrapper {
            grid-column: 1/13;
            grid-row: 1;
            grid-template-columns: repeat(6, 1fr);
        }

        .imageWrapper {
            border-right: 1px solid var(--border-color);
            grid-column: 1/8;
            grid-row: 2;
            display: grid;
            grid-template-columns: subgrid;
            align-items: center;
            height: 100%;
        }

        .imageContainer {
            grid-column: 2/7;

            .partnerImage {
                margin: 0;
            }
        }

        .partnerImage {
            margin: 0;
            object-position: center center;
        }

        .partnersDescriptionWrapper {
            grid-column: 8/13;
            display: flex;
            flex-direction: column;
            justify-content: end;
        }

        .partnersDescription {
            h2 {
                margin: 0rem 0rem 2rem 0rem;
                font-size: 3rem;
            }
        }

        .partnerBtn {
            transition: all 0.2s ease-in-out;
        }

        .partnerBtn:hover {
            background-color: var(--color-knop-magenta);
            color: var(--color-light);
        }

        .partnersDescriptionInfo {
            text-align: start;
            justify-content: space-between;
            flex-wrap: nowrap;
        }

        .partnersWrapper {
            height: auto;
            padding: var(--padding-tablet);
        }

        @media screen and (min-width: 1600px) {
            .partnersWrapper {
                padding: var(--padding-desktop);
            }
            .imageContainer {
                padding: var(--padding-desktop) 0;
            }
            .partnersDescription {
                padding: 4rem;

                p {
                    font-size: 1.15rem;
                }

                &.active {
                    display: flex;
                    justify-content: center;
                    align-items: center;
                }
            }

            .infoLeisteContainer {
                .partnersDescriptionInfo {
                    .infoPoint:nth-child(n + 3) {
                        border-bottom: none;
                    }
                }
            }
            .textBlock {
                padding: 0;
            }
        }

        @media screen and (min-width: 2000px) {
            .partnersDescription {
                padding: var(--padding-desktop);
            }
            .descriptionsContainer {
                min-height: 550px;
            }
        }
    }
</style>

<script>
    import { gsap } from "gsap";

    const buttons = document.querySelectorAll(".partnerBtn");
    let currentPartnerId = document
        .querySelector(".partnerBtn.active")
        ?.getAttribute("data-partner");

    //Initialen Zustand für das ALLERERSTE Element setzen, damit es beim Laden sichtbar ist
    gsap.set(
        [
            ".partnerImage.active",
            ".partnersDescription.active",
            ".partnersDescriptionInfo.active",
        ],
        {
            opacity: 1,
            y: 0,
        },
    );

    buttons.forEach((button) => {
        button.addEventListener("click", () => {
            const targetPartner = button.getAttribute("data-partner");

            if (targetPartner === currentPartnerId) return;
            currentPartnerId = targetPartner;

            buttons.forEach((btn) => btn.classList.remove("active"));
            button.classList.add("active");

            const activeImg = document.querySelector(".partnerImage.active");
            const activeDesc = document.querySelector(
                ".partnersDescription.active",
            );
            const activeInfo = document.querySelector(
                ".partnersDescriptionInfo.active",
            );

            const nextImg = document.querySelector(
                `.partnerImage[data-id="${targetPartner}"]`,
            );
            const nextDesc = document.querySelector(
                `.partnersDescription[data-description="${targetPartner}"]`,
            );
            const nextInfo = document.querySelector(
                `.partnersDescriptionInfo[data-info="${targetPartner}"]`,
            );

            const tl = gsap.timeline();

            // 1. Altes Zeug ausfaden
            if (activeImg && activeDesc && activeInfo) {
                tl.to([activeImg, activeDesc, activeInfo], {
                    opacity: 0,
                    y: -15,
                    duration: 0.2,
                    ease: "power2.in",
                });
            }

            tl.call(() => {
                activeImg?.classList.remove("active");
                activeDesc?.classList.remove("active");
                activeInfo?.classList.remove("active");

                if (nextImg && nextDesc && nextInfo) {
                    gsap.set([nextImg, nextDesc, nextInfo], {
                        y: 15,
                        opacity: 0,
                    });
                    nextImg.classList.add("active");
                    nextDesc.classList.add("active");
                    nextInfo.classList.add("active");
                }
            });

            if (nextImg && nextDesc && nextInfo) {
                tl.to([nextImg, nextDesc, nextInfo], {
                    opacity: 1,
                    y: 0,
                    duration: 0.35,
                    ease: "power2.out",
                });

                //Micro-Animation für innere Texte
                const textElements = nextDesc.querySelectorAll("h2, p");
                const infoPoints = nextInfo.querySelectorAll(".infoPoint");

                tl.fromTo(
                    [textElements, infoPoints],
                    { opacity: 0, y: 8 },
                    {
                        opacity: 1,
                        y: 0,
                        duration: 0.25,
                        stagger: 0.04,
                        ease: "power1.out",
                    },
                    "-=0.2",
                );
            }
        });
    });
</script>
