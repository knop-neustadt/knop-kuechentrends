---
import contactPicture from "../assets/images/kueche/contactPicture.jpg";
import Image from "astro/components/Image.astro";
---

<section class="contactSection" id="contactSection">
    <div class="contactWrapper" id="contactWrapper">
        <div class="formLeft">
            <div class="formLeftContent">
                <div class="contactGreeting">
                    <h2>Kontaktieren Sie uns!</h2>
                    <p>
                        Wir sind für Sie da, wenn Sie Fragen haben oder eine
                        Beratung brauchen.
                    </p>
                </div>
                <form action="https://api.web3forms.com/submit" method="POST">
                    <input
                        type="hidden"
                        name="access_key"
                        value="674c350f-81d6-4780-bedd-db6eb6f08a74"
                    />
                    <div class="formInput">
                        <label for="name">Name:*</label>
                        <input type="text" id="name" name="name" required />
                    </div>
                    <div class="formInput">
                        <label for="email">E-Mail:*</label>
                        <input type="email" id="email" name="email" required />
                    </div>
                    <div class="formInput">
                        <label for="number">Telefonnummer:</label>
                        <input
                            type="text"
                            id="number"
                            name="Phone Number"
                            required
                        />
                    </div>
                    <div class="formInput">
                        <label for="subject">Betreff:*</label>
                        <input
                            type="text"
                            id="subject"
                            name="subject"
                            required
                        />
                    </div>
                    <div class="formInput">
                        <label for="message">Ihre Nachricht:*</label>
                        <textarea name="message" id="message" required
                        ></textarea>
                    </div>
                    <button type="submit">Absenden</button>
                </form>
            </div>
        </div>
        <Image
            src={contactPicture}
            alt="Bild einer Musterküche von Knop Neustadt"
            widths={[240, 540, 1400]}
            sizes="(max-width: 360px) 240px,(max-width:720px) 540px, (max-width: 1600px) 1400px"
            loading={"lazy"}
            quality={50}
        />
    </div>
</section>

<style>
    .contactSection {
        background-color: var(--color-light);
        color: var(--color-dark);
    }

    input,
    textarea,
    button {
        border: 1px solid var(--color-dark);
        transition: all ease-in-out 0.3s;
        padding: 1rem;
        font-size: 1.25rem;
    }

    input:focus,
    textarea:focus {
        border-color: var(--color-knop-magenta);
        outline: none;
    }

    button {
        padding: 0.75rem;
        cursor: pointer;
        transition: all ease-in-out 0.1s;
        width: 100%;
        border: 1px solid var(--color-knop-magenta);
    }

    button:hover {
        background-color: var(--color-knop-magenta);
        color: var(--color-light);
    }

    .formInput {
        display: flex;
        flex-direction: column;
        padding-bottom: 1rem;
    }

    textarea {
        height: 100%;
        min-height: 250px; /* Auf Mobilgeräten etwas kompakter */
        resize: none;
    }

    /* Beseitigt den ungewollten Inlinemargins/Unterlängen-Abstand */
    img {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 3/4;
        padding-top: 2rem;
        object-fit: cover;
        object-position: top;
    }

    .contactGreeting {
        padding: 0rem 0rem 1rem 0rem;
    }

    label {
        font-weight: 500;
        padding-bottom: 0.25rem;
    }
    @media screen and (min-width: 760px) {
        .contactSection {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .contactWrapper {
            display: grid;
            grid-template-columns: repeat(12, 1fr);
            justify-content: center;
            align-items: center;
        }

        .formLeft {
            grid-column: 1/7;
            display: flex;
            flex-direction: column;
        }

        .formLeftContent {
            padding-right: var(--column-width-tablet);
        }

        form {
            width: 100%;
            display: flex;
            flex-direction: column;
            gap: 1rem;
            flex: 1; /* Formular füllt die volle verbleibende Höhe aus */
        }

        .formInput {
            padding: 0;
        }

        /* Das Textarea-Feld dehnt sich flexibel aus, um den verbleibenden Platz einzunehmen */
        .formInput:last-of-type {
            display: flex;
            flex-direction: column;
            flex: 1;
        }

        textarea {
            flex: 1;
            min-height: 0; /* Verhindert, dass min-height die Flex-Verteilung blockiert */
        }

        img {
            padding: 0;
            grid-column: 7/13;
            width: 100%;
            height: 100%;
            aspect-ratio: 1/1;
            object-fit: cover;
        }
    }

    @media screen and (min-width: 1450px) {
        .formLeftContent {
            padding-right: var(--column-width-desktop);
        }

        img{
            grid-column: 8/12;

        }
    }

    @media screen and (min-width: 1800px) {
        .formLeftContent {
            padding: 0 var(--column-width-desktop);
        }
    }
</style>
