---
import contactPicture from "../assets/images/contactPicture.jpg";
import Image from "astro/components/Image.astro";
---

<section class="contactSection" id="contactSection">
    <div class="contactWrapper" id="contactWrapper">
        <div class="formLeft">
            <div class="contactGreeting">
                <h2>Kontaktieren Sie uns!</h2>
                <p>
                    Wir sind für Sie da, wenn Sie Fragen haben oder eine
                    Beratung brauchen.
                </p>
            </div>
            <form action="https://api.web3forms.com/submit" method="POST">
                <input
                    type="hidden"
                    name="access_key"
                    value="674c350f-81d6-4780-bedd-db6eb6f08a74"
                />
                <div class="formInput">
                    <label for="name">Name:*</label>
                    <input type="text" id="name" name="name" required />
                </div>
                <div class="formInput">
                    <label for="email">E-Mail:*</label>
                    <input type="email" id="email" name="email" required />
                </div>
                <div class="formInput">
                    <label for="number">Telefonnummer:</label>
                    <input
                        type="text"
                        id="number"
                        name="Phone Number"
                        required
                    />
                </div>
                <div class="formInput">
                    <label for="subject">Betreff:*</label>
                    <input type="text" id="subject" name="subject" required />
                </div>
                <div class="formInput">
                    <label for="message">Ihre Nachricht:*</label>
                    <textarea name="message" required></textarea>
                </div>
                <button type="submit">Absenden</button>
            </form>
        </div>
        <Image
            src={contactPicture}
            alt="Bild einer Musterküche von Knop Neustadt"
            widths={[240, 540, 1400]}
            sizes="(max-width: 360px) 240px,(max-width:720px) 540px, (max-width: 1600px) 1400px"
            loading={"lazy"}
            quality={50}
        />
    </div>
</section>

<style>
    .contactSection {
        background-color: var(--color-light);
        color: var(--color-dark);
    }

    input,
    textarea,
    button {
        border: 1px solid var(--color-dark);
        padding: 1rem;
    }
    button {
        padding: 0.75rem;
        cursor: pointer;
        transition: all ease-in-out 0.1s;
        width: 100%;
        border: 1px solid var(--color-knop-magenta);
    }
    button:hover {
        background-color: var(--color-knop-magenta);
        color: var(--color-light);
    }

    .formInput {
        display: flex;
        flex-direction: column;
        padding-bottom: 1rem;
    }

    textarea {
        height: 100%;
        resize: none;
        min-height: 260px;
    }

    img {
        aspect-ratio: 3/4;
        padding-top: 2rem;
        object-position: top;
    }

    .contactGreeting {
        padding: 0rem 0rem 1rem 0rem;
    }

    @media screen and (min-width: 760px) {
        .contactSection {
            min-height: 80vh;
        }

        .contactWrapper {
            display: flex;
            justify-content: space-between;
            gap: 2rem;
            height: 100%;
            align-items: center;
        }

        img {
            aspect-ratio: 1/1;
            max-width: 50%;
            height: 100%;
            padding: 0;
            object-position: top;
        }

        form {
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .formInput {
            padding: 0;
        }

        .formInput:last-of-type {
            display: flex;
            flex-direction: column;
            flex: 1;
            height: 100%;
        }

        .formLeft {
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: column;
        }

        textarea {
            flex: 1;
            min-height: auto;
        }
    }

    @media screen and (min-width: 1280px) {
        .contactSection {
            min-height: 100vh;
        }

        .contactWrapper {
            gap: var(--padding-desktop);
        }
    }
</style>
