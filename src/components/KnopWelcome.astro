---
interface Props {
    subHeading?: string;
    headingMain1?: string;
    headingMain2?: string;
    headingSpan?: string;
    paragraph?: string;
    buttonText?: string;
    buttonLink?: string;
    bgMobile?: string;
    bgDesktop?: string;
}

const {
    subHeading = "",
    headingMain1 = "",
    headingMain2 = "",
    headingSpan = "",
    paragraph = "",
    bgMobile = "",
    bgDesktop = ""
} = Astro.props;
---

<section class="welcomeWrapper">
    <div class="stylediv"></div>
    <div class="welcomeTextWrapper">
        <div class="subHeadingWrapper">
            <p class="subHeading">{subHeading}</p>
        </div>
        <div class="headingWrapper">
            <h1 class="heading">
                {headingMain1} <span>{headingSpan}</span>{headingMain2}
            </h1>
        </div>

        <div class="ctaWrapper">
            <p class="welcomeParagraph">
                {paragraph}
            </p>
            <div class="welcomeButtonsWrapper">
                <a href="#contactSection" class="linkBtn">Kontakt</a>
            </div>
        </div>
    </div>
</section>
<style define:vars={{ bgMobile: `url(${bgMobile})`, bgDesktop: `url(${bgDesktop})` }}>
    span {
        display: block;
    }
    .welcomeWrapper {
        display: grid;
        min-height: 100svh;
        background-image: var(--bgMobile);
        background-position: center;
        background-size: cover;
    }

    .stylediv {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 60%;
        background: #000;
        background: #19181f;
        background: linear-gradient(
            0deg,
            rgba(25, 24, 31, 1) 30%,
            rgba(0, 0, 0, 0) 100%
        );
    }

    .welcomeTextWrapper {
        color: var(--color-light);
        align-self: flex-end;
        z-index: 1;
    }

    h1 {
        font-weight: normal;
        font-size: 3.5rem;
        font-weight: 600;
        line-height: 3rem;
        text-transform: uppercase;
    }

    .headingWrapper {
        margin-bottom: 5rem;
    }

    .welcomeButtonsWrapper {
        display: flex;
        align-items: center;
        font-weight: 600;
        margin-top: 1rem;
        a {
            color: var(--color-light);
            cursor: pointer;
            font-size: 1.25rem;
            padding: 1.25rem;
            width: 100%;
            transition: all ease-in-out 0.1s;
            background-color: var(--color-knop-magenta);
            color: var(--color-light);
            text-align: center;
            &:hover {
                background-color: var(--color-light);
                color: var(--color-dark);
            }
        }
    }

    .heading,
    p.welcomeParagraph,
    .subHeading,
    .welcomeButtonsWrapper {
        opacity: 0;
    }

    .headingWrapper,
    .subHeadingWrapper {
        overflow: hidden;
    }

    @media screen and (min-width: 1280px) {
        .welcomeWrapper {
            background-image: var(--bgDesktop);
        }

        .welcomeTextWrapper {
            align-self: center;
        }

        p.welcomeParagraph {
            max-width: 600px;
            font-size: 1.5rem;
        }

        h1 {
            line-height: 0.85;
            font-size: 8rem;
        }

        .headingWrapper {
            margin-bottom: 7.5rem;
        }

        .stylediv {
            height: 100%;
            width: 50%;
            background: #19181f;
            background: linear-gradient(
                90deg,
                rgba(25, 24, 31, 1) 30%,
                rgba(0, 0, 0, 0) 100%
            );
        }

        .ctaWrapper {
            width: 600px;
        }
    }
</style>

<script>
    import { gsap } from "gsap";
    import { SplitText } from "gsap/SplitText";
    gsap.registerPlugin(SplitText);

    const mainHeading = document.querySelector(".heading");
    const subHeading = document.querySelector(".subHeading");
    const welcomeParagraph = document.querySelector(".welcomeParagraph");
    const welcomeButton = document.querySelector(".welcomeButtonsWrapper");

    gsap.set(mainHeading, { opacity: 1 });
    gsap.set(subHeading, { opacity: 1 });
    gsap.set(welcomeParagraph, { opacity: 1 });
    gsap.set(welcomeButton, { opacity: 1 });

    const splitHeading = new SplitText(mainHeading, {
        type: "lines, words",
        mask: "lines",
        wordsClass: "headingWord",
        aria: "none",
    });
    const splitSubHeading = new SplitText(subHeading, {
        type: "words",
        aria: "none",
    });
    const splitWelcomeParagraph = new SplitText(welcomeParagraph, {
        type: "lines",
        mask: "lines",
        aria: "none",
    });

    const tl = gsap.timeline();

    tl.from(splitSubHeading.words, {
        y: 20,
        stagger: 0.03,
        duration: 0.3,
        opacity: 0,
        transformOrigin: "center top",
        ease: "power2.out",
    });

    tl.from(splitHeading.lines, {
        y: 20,
        stagger: 0.08,
        duration: 0.3,
        opacity: 0,
        transformOrigin: "center top",
        ease: "power2.out",
    });

    tl.from(splitWelcomeParagraph.lines, {
        y: 20,
        stagger: 0.1,
        duration: 0.3,
        opacity: 0,
        transformOrigin: "center top",
        ease: "power2.out",
    });

    tl.from(welcomeButton, {
        y: 10,
        duration: 0.3,
        opacity: 0,
        transformOrigin: "center top",
        ease: "power2.out",
    });
</script>
