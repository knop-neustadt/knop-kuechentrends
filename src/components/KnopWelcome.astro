<section class="welcomeWrapper">
    <div class="stylediv"></div>
    <div class="welcomeTextWrapper">
        <div class="subHeadingWrapper">
            <p class="subHeading">Küchentrends</p>
        </div>
        <div class="headingWrapper">
            <h1 class="heading">
                Ihr Partner <span>für die neue Küche</span> in Neustadt!
            </h1>
        </div>

        <p class="welcomeParagraph">
            Knop Neustadt schafft Küchen, die leben. Mit handwerklicher
            Präzision und modernem Design entstehen Räume, in denen Qualität
            spürbar wird.
        </p>

        <div class="welcomeButtonsWrapper">
            <a href="/galerie">Galerie</a>
            <a href="#kontakt">Kontakt</a>
        </div>
    </div>
</section>
<style>
    span {
        display: block;
    }
    .welcomeWrapper {
        display: grid;
        min-height: 100svh;
        background-image: url(/src/assets/images/welcomePicture.webp);
        background-position: center;
        background-size: cover;
    }

    .stylediv {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 60%;
        background: #000;
        background: #19181f;
        background: linear-gradient(
            0deg,
            rgba(25, 24, 31, 1) 30%,
            rgba(0, 0, 0, 0) 100%
        );
    }

    .welcomeTextWrapper {
        color: var(--color-light);
        align-self: flex-end;
        z-index: 1;
    }

    h1 {
        font-weight: normal;
        font-size: 3.5rem;
        font-weight: 600;
        line-height: 3rem;
        text-transform: uppercase;
    }

    .headingWrapper {
        margin-bottom: 5rem;
    }

    .welcomeButtonsWrapper {
        display: flex;
        align-items: center;
        font-weight: 600;
        transform: translate(-0.5rem);
        margin-top: 1rem;
        a {
            color: var(--color-light);
            cursor: pointer;
            margin-right: 1rem;
            font-size: 1.25rem;
            padding: 0.5rem;
            transition: all ease-in-out 0.1s;
            text-decoration: underline;

            &:hover {
                background-color: var(--color-light);
                color: var(--color-dark);
            }
        }
    }

    .heading {
        opacity: 0;
    }

    .headingWrapper,
    .subHeadingWrapper {
        overflow: hidden;
    }

    @media screen and (min-width: 1024px) {
        .welcomeWrapper {
            padding: var(--padding-desktop);
            background-image: url(/src/assets/images/welcomePictureDesktop.webp);
        }

        .welcomeTextWrapper {
            align-self: center;
        }

        p.welcomeParagraph {
            max-width: 600px;
            font-size: 1.5rem;
        }

        h1 {
            line-height: 0.85;
            font-size: 8rem;
        }

        .headingWrapper {
            margin-bottom: 7.5rem;
        }

        .stylediv {
            height: 100%;
            width: 50%;
            background: #19181f;
            background: linear-gradient(
                90deg,
                rgba(25, 24, 31, 1) 30%,
                rgba(0, 0, 0, 0) 100%
            );
        }
    }
</style>

<script>
    import { templateLiteral } from "astro:schema";
    import { gsap } from "gsap";
    import { SplitText } from "gsap/SplitText";
    gsap.registerPlugin(SplitText);

    const mainHeading = document.querySelector(".heading");
    const subHeading = document.querySelector(".subHeading");
    const welcomeParagraph = document.querySelector(".welcomeParagraph");

    gsap.set(mainHeading, { opacity: 1 });

    const splitHeading = new SplitText(mainHeading, {
        type: "lines, words",
        mask: "lines",
        wordsClass: "headingWord",
    });
    const splitSubHeading = new SplitText(subHeading, { type: "words" });

    const splitWelcomeParagraph = new SplitText(welcomeParagraph, {
        type: "lines",
        mask:"lines"
    });

    const tl = gsap.timeline();

    tl.from(splitHeading.lines, {
        y: 80,
        stagger: 0.09,
        duration: 0.8,
        opacity: 0,
        transformOrigin: "center top",
        ease: "power2.out",
    });

    tl.from(splitWelcomeParagraph.lines, {
        y: 80,
        stagger: 0.09,
        duration: 0.8,
        opacity: 0,
        transformOrigin: "center top",
        ease: "power2.out",
    });
</script>
