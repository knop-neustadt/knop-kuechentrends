---
import { Image } from "astro:assets";
import { getImage } from "astro:assets";
import "photoswipe/style.css";

// 1. Alle Bilder automatisch per Vite glob importieren
const imageModules = import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/images/kueche/galerie/*.{jpeg,jpg,png,webp}",
    { eager: true },
);

// 2. Metadaten aus dem Dateinamen parsen
const galleryItems = await Promise.all(
    Object.entries(imageModules).map(async ([filepath, module], index) => {
        const originalImage = module.default;

        // Dateiname ohne Pfad und Endung
        const filename =
            filepath
                .split("/")
                .pop()
                ?.replace(/\.[^/.]+$/, "") || "";

        const parts = filename.split("_");
        let category = "Allgemein";
        let rawTitle = filename;

        if (parts.length > 1) {
            category = parts[0];
            rawTitle = parts.slice(1).join("_");
        }

        const title = rawTitle
            .replace(/[\d\-()]/g, " ")
            .replace(/\s+/g, " ")
            .trim();

        const alt = `Küchenstudio Referenz: ${title} (${category})`;

        // Originalgröße
        const { width, height } = originalImage;

        // NEU: sehr kleines Hintergrundbild erzeugen
        const placeholder = await getImage({
            src: originalImage,
            width: Math.round(width / 1000),
            height: Math.round(height / 1000),
            format: "webp",
        });

        // Seitenverhältnis
        const ratio = width / height;

        let spanClasses = "col-span-1 row-span-1";

        if (index % 7 === 0) {
            spanClasses = "col-span-2 row-span-2";
        } else if (ratio < 0.85) {
            spanClasses = "col-span-1 row-span-2";
        } else if (ratio > 1.7) {
            spanClasses = "col-span-3 row-span-1";
        } else if (ratio > 1.35) {
            spanClasses = "col-span-2 row-span-1";
        } else {
            spanClasses = "col-span-1 row-span-1";
        }

        return {
            image: module.default,
            placeholder, // NEU
            title,
            category,
            alt,
            spanClasses,
        };
    }),
);
---

<section>
    <div
        id="kuechen-gallery"
        class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-10 grid-flow-dense"
    >
        {
            galleryItems.map((item) => (
                <a
                    href={item.image.src}
                    data-pswp-width={item.image.width /2}
                    data-pswp-height={item.image.height /2}
                    target="_blank"
                    class={`group relative block overflow-hidden bg-gray-200 shadow-sm transition-all duration-300 hover:shadow-lg focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 galleryImageLink ${item.spanClasses}`}
                    style={`background-image: url(${item.placeholder.src}); background-size: cover; background-position: center; backdrop-filter: blur(10px);`}
                >
                    <Image
                        src={item.image}
                        alt={item.alt}
                        width={item.image.width / 4}
                        height={item.image.height / 4}
                        format="webp"
                        class={`w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105 ${
                            item.spanClasses.includes("row-span-2")
                                ? "h-[36.75rem]"
                                : "h-72"
                        }`}
                    />

                    <div class="absolute inset-0 bg-linear-to-t from-black/80 via-black/25 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100 flex flex-col justify-end p-5">
                        <span class="text-sm font-bold uppercase">
                            {item.category}
                        </span>
                        <p class="mt-1 text-sm font-medium text-white line-clamp-2">
                            {item.title}
                        </p>
                    </div>
                </a>
            ))
        }
    </div>
</section>

<style>
    section{
        padding-top: var(--padding-top);
    }

    span {
        color: var(--color-light);
    }
</style>

<script>
    import PhotoSwipeLightbox from "photoswipe/lightbox";

    const lightbox = new PhotoSwipeLightbox({
        gallery: "#kuechen-gallery",
        children: "a",
        pswpModule: () => import("photoswipe"),
        showHideAnimationType: "fade",
    });

    lightbox.init();
</script>
