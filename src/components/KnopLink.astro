---
interface Props {
    linkto: string;
    linkName: string;
}

const { linkto = "", linkName = "" } = Astro.props;
---

<div class="linkWrapper">
    <a href={linkto} class="linkBtn">{linkName}</a>
</div>

<style>
    .linkWrapper {
        display: flex;
        align-items: center;
        font-weight: 600;
        margin-top: 1.5rem;
        a {
            cursor: pointer;
            font-size: 1rem;
            padding: 1rem 1.25rem;
            width: 100%;
            border: 1px solid var(--color-dark);

            transition: all ease-in-out var(--animation-time);

            color: var(--color-dark);
            text-align: center;
            &:hover {
                background-color: var(--color-light);
                color: var(--color-dark);
                border: 1px solid var(--color-knop-magenta);
                background-color: var(--color-knop-magenta);
                color: var(--color-light);
            }
        }
    }
</style>
