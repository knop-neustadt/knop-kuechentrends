                </p>

                <Image
                    src={küche2}
                    alt="Ein Bild von drei Handwerkern, die über einen Zebrastreifen gehen."
                    class="collapseImage"
                    widths={[400, 600, 800, 1200]}
                />
            </div>
        </div>
    </div>
</section>

<style>
    .collapse {
        border-bottom: solid 1px var(--color-dark);
        border-radius: 0;
        font-size: 2rem;
    }

    .subHeading{
            border-bottom: var(--color-dark) 1px solid;

    }

    .contentSpacing {
        margin-top: 9rem;
    }

    .collapseImage {
        width: 100%;
        height: 50%;
        object-fit: cover;
        margin: 1rem 0rem;
        border-radius: 10px;
    }

    .collapse-title {
        display: flex;
        font-family: var(--font-alumni);
        gap: 0.5rem;
        align-items: center;
        font-size: 2rem;

        p {
            width: 1rem;
            text-align: center;
        }
    }

    .collapse-title::after {
        top: 0rem;
        right: 0.5rem;
        font-family: var(--font-alumni);
        font-weight: 400;
    }

    @media screen and (min-width: 1024px) {
        .processWrapper {
            margin: auto;
        }

        .collapse {
            font-size: 4rem;
        }
        .collapse-title {
            gap: 2rem;
            font-size: 5.5rem;
            font-weight: 500;
            p {
                width: 2.5rem;
            }
        }

        .collapse-title::after {
            top: 0rem;
            inset-inline-end: 2rem !important;

        }

        .collapseImage {
            width: 100%;
            height: auto;

            margin: 0;
            grid-column: 7/13;
        }

        .contentSpacing {
            display: grid;
            margin: 0;
            padding: 5rem 0rem;

            grid-template-columns: repeat(12, 1fr);
            p {
                align-self: end;
                grid-column: 1/6;
                font-size: 1.25rem;
                max-width: 800px;
            }

            .collapse-plus {
                font-size: 1rem;
                transform: translate(2rem 2rem);
            }
        }
    }
</style>
